# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stayease?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change_this_to_a_different_random_string
REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@stayease.dev
ADMIN_PASSWORD=change_this_before_use

# ── Email (future — not active) ───────────────────────────────────────────────
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your_sendgrid_api_key
# EMAIL_FROM=noreply@stayease.dev
